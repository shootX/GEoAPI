    "test": "tsc -p tsconfig.json && node --test test/server.test.mjs"
  },
  "dependencies": {
    "@geoapi/sdk": "file:../sdk-js",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.2"
  }
}
