{
  "name": "@geoapi/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "geoapi": "./dist/index.js"
  },
  "exports": {
    ".": {
